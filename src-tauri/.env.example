# Copy this file to `.env` (same directory) and fill in the values you need.
# Loaded automatically via dotenvy in `run()`; only keys for the provider(s) you use are required.

# Required for provider = "google" (Gemini API)
GOOGLE_API_KEY=

# Required for provider = "openrouter"
OPENROUTER_API_KEY=

# The following providers need no API key:
# - "ollama"     -> localhost:11434
# - "llamacpp"   -> llama-server on localhost:8080
